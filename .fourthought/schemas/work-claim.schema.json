{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fourthought claim",
  "type": "object",
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "class": {
      "enum": [
        "feature",
        "bug",
        "refactor",
        "investigation",
        "architecture",
        "security"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "likely_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?![A-Za-z]:)(?!.*[\\u0000-\\u001f]).*\\S.*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "components",
        "likely_paths"
      ],
      "additionalProperties": false
    },
    "collision_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "parallel_safe": {
      "type": "boolean"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "lease": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "pending",
            "active",
            "released",
            "expired",
            "quarantined"
          ]
        },
        "holder": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expires_at": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            }
          },
          "then": {
            "required": [
              "holder",
              "token",
              "expires_at"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "issue",
    "class",
    "scope",
    "collision_domains",
    "depends_on",
    "parallel_safe",
    "risk",
    "lease"
  ],
  "additionalProperties": false
}
