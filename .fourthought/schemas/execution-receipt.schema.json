{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fourthought receipt",
  "type": "object",
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "plan",
        "implement",
        "verify",
        "review",
        "remediate",
        "assurance",
        "product"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?![A-Za-z]:)(?!.*[\\u0000-\\u001f]).*\\S.*$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "issue",
    "stage",
    "result",
    "head",
    "actor",
    "evidence",
    "changed_paths"
  ],
  "additionalProperties": false
}
