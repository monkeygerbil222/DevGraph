# Copy to ~/.devgraph/.env (or .env at the DevGraph checkout root) and adjust
# if needed. A .env in the current working directory is not read.
# Exported environment variables override these files. Never commit the real .env.
DEVGRAPH_NEO4J_URI=bolt://127.0.0.1:7687
DEVGRAPH_NEO4J_USER=neo4j
DEVGRAPH_NEO4J_PASSWORD=devgraph-local-dev
DEVGRAPH_TELEMETRY_ENABLED=false
DEVGRAPH_ALLOW_CROSS_REPO=false
DEVGRAPH_CLOUD_SYNC=false
# Files larger than this many bytes are not extracted (default 1 MiB).
DEVGRAPH_MAX_FILE_BYTES=1048576
# The watcher waits this long after the last file event before re-indexing,
# and while events keep coming, flushes at least every DEVGRAPH_WATCH_MAX_WAIT_MS.
DEVGRAPH_WATCH_DEBOUNCE_MS=500
DEVGRAPH_WATCH_MAX_WAIT_MS=5000
# How long an MCP server may take to get a Neo4j connection, and how long
# `devgraph status` and `doctor` wait for their connection check (seconds).
DEVGRAPH_MCP_CONNECTION_TIMEOUT_S=2
DEVGRAPH_NEO4J_PROBE_TIMEOUT_S=5
